wrapAmount = 150;

dialogueString[0] = "Ho hum. It would appear the great Beckett has been momentarily stumped yet again."
dialogueString[1] = "Sadly, this time I fear a way forward is a moot gesture."
dialogueString[2] = "Or, to put it another way: this is the end of the demo."
dialogueString[3] = "We sincerely thank you for your time, and we hope you enjoyed."
dialogueString[4] = "If you enjoyed, why not wishlist Seeing Double on Steam? It would really help us out."
dialogueString[5] = "Thanks again, and until next time."

